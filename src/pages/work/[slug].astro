<script>
  // Stamp choreography: curtain lifts, the title types itself, then the
  // stamp lands (quick snap) and the curly ink lines draw over it. The
  // title's TypeLine dispatches tw-done when it finishes; a generous
  // timeout backstops it. Reduced motion or no JS: static, already there.
  let stampInited = false;
  function initStamp() {
    if (stampInited) return;
    const el = document.querySelector<HTMLElement>("[data-stamp]");
    if (!el) return;
    stampInited = true;
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
      el.style.visibility = "";
      return;
    }
    el.classList.add("is-armed");
    let landed = false;
    const land = () => {
      if (landed) return;
      landed = true;
      el.style.visibility = "";
      el.classList.add("is-stamped");
      window.setTimeout(() => el.classList.add("is-in"), 180);
    };
    document
      .querySelector(".case-title")
      ?.addEventListener("tw-done", () => window.setTimeout(land, 200), { once: true });
    window.setTimeout(land, 7000);
  }
  document.addEventListener("astro:before-swap", () => (stampInited = false));
  initStamp();
  document.addEventListener("astro:page-load", initStamp);

  // Build-stage skyline header: the divider + heading wipe in together when
  // the group enters the viewport (and replay on hover, via CSS). Armed by JS
  // so no-JS visitors see it fully revealed; reduced motion stays static.
  function initSkylines() {
    const heads = document.querySelectorAll<HTMLElement>(".skyline-head");
    if (!heads.length) return;
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const io = new IntersectionObserver(
      (entries, obs) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add("in-view");
            obs.unobserve(e.target);
          }
        }
      },
      { threshold: 0.4 },
    );
    heads.forEach((h) => {
      h.classList.add("reveal-ready");
      io.observe(h);
    });
  }
  initSkylines();
  document.addEventListener("astro:page-load", initSkylines);

  // "Look closer" enlarge hint: drop a small label into every click-to-enlarge
  // figure. JS-only by design, it advertises the lightbox, which itself needs
  // JS, so no-JS visitors correctly see neither. Idempotent, re-runs per page.
  function initZoomHints() {
    // the label speaks the page's language; it rides on the article's data
    // attribute so this shared script needs no locale knowledge of its own
    const label =
      document.querySelector<HTMLElement>(".case")?.dataset.uiLookcloser ?? "Look closer";
    document.querySelectorAll<HTMLElement>(".prose .fig").forEach((fig) => {
      if (!fig.querySelector("img") || fig.querySelector(".fig__zoom")) return;
      const hint = document.createElement("span");
      hint.className = "fig__zoom";
      hint.setAttribute("aria-hidden", "true");
      const text = document.createElement("span");
      text.className = "fig__zoom-t";
      text.textContent = label;
      hint.appendChild(text);
      fig.appendChild(hint);
    });
  }
  initZoomHints();
  document.addEventListener("astro:page-load", initZoomHints);

  // Click-to-enlarge lightbox for case-study images. GOTCHA: Astro's
  // ClientRouter replaces <body> on a view transition, so an overlay appended
  // to <body> once is DETACHED after the first in-site navigation and clicks
  // then open a box that is not in the DOM (nothing shows). So the overlay is
  // (re)created per page via ensureBox(), while the delegated click/key
  // listeners are registered once on document. Close via the button, a
  // backdrop click, or Escape.
  interface LightboxWindow extends Window { __caseLightbox?: boolean }
  (() => {
    const w = window as unknown as LightboxWindow;
    let lastFocus: HTMLElement | null = null;

    function ensureBox(): HTMLElement {
      const existing = document.querySelector<HTMLElement>(".lightbox");
      if (existing) return existing;
      const box = document.createElement("div");
      box.className = "lightbox";
      box.setAttribute("role", "dialog");
      box.setAttribute("aria-modal", "true");
      box.setAttribute("aria-hidden", "true");
      const closeLabel =
        document.querySelector<HTMLElement>(".case")?.dataset.uiClose ?? "Close";
      box.innerHTML =
        `<button class="lightbox__close" type="button" aria-label="${closeLabel}">×</button>` +
        '<img class="lightbox__img" alt="" />' +
        '<p class="lightbox__cap"></p>';
      document.body.appendChild(box);
      // close: backdrop click (the overlay itself) or the close button
      box.addEventListener("click", (e) => { if (e.target === box) close(); });
      box.querySelector<HTMLButtonElement>(".lightbox__close")!.addEventListener("click", close);
      return box;
    }

    function open(src: string, alt: string, cap: string) {
      const box = ensureBox();
      const imgEl = box.querySelector(".lightbox__img") as HTMLImageElement;
      const capEl = box.querySelector(".lightbox__cap") as HTMLElement;
      imgEl.src = src;
      imgEl.alt = alt;
      capEl.textContent = cap;
      capEl.style.display = cap ? "" : "none";
      lastFocus = document.activeElement as HTMLElement;
      box.classList.add("is-open");
      box.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      (box.querySelector(".lightbox__close") as HTMLElement).focus();
    }
    function close() {
      const box = document.querySelector<HTMLElement>(".lightbox");
      if (!box) return;
      box.classList.remove("is-open");
      box.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      lastFocus?.focus();
    }

    // register the global listeners once (they survive view transitions)
    if (!w.__caseLightbox) {
      w.__caseLightbox = true;
      // open: delegated click on any case image OR its "Look closer" hint. The
      // hint sits over the caption row, not the image, so resolve it back to the
      // figure's visible <img> (theme-swap figures keep two).
      document.addEventListener("click", (e) => {
        const t = e.target as HTMLElement;
        let img = t.closest(".prose .fig img") as HTMLImageElement | null;
        if (!img) {
          const fig = t.closest(".prose .fig .fig__zoom")?.closest(".fig");
          if (fig) {
            const imgs = Array.from(fig.querySelectorAll<HTMLImageElement>("img"));
            img = imgs.find((i) => i.offsetParent !== null) ?? imgs[0] ?? null;
          }
        }
        if (!img) return;
        const cap = img.closest(".fig")?.querySelector("figcaption")?.textContent?.trim() ?? "";
        open(img.currentSrc || img.src, img.alt || "", cap);
      });
      document.addEventListener("keydown", (e) => {
        const box = document.querySelector(".lightbox");
        if (e.key === "Escape" && box && box.classList.contains("is-open")) close();
      });
    }

    // ensure the overlay is present on this page, and re-create it after every
    // view-transition swap (which drops the previous one from <body>)
    ensureBox();
    document.addEventListener("astro:page-load", ensureBox);
  })();
</script>

<script>
  // FLIZ Emote-style scroll layer. Loaded ONLY on the FLIZ case (guarded on
  // [data-fliz]); GSAP + Lenis come in via dynamic import(), so they are a
  // separate chunk that never ships to any other case page. Torn down on
  // navigation away; fully skipped under prefers-reduced-motion.
  interface FzCtx {
    lenis: any;
    ticker: (t: number) => void;
    gsap: any;
    ScrollTrigger: any;
  }
  let fz: FzCtx | null = null;
  let fzBooting = false;

  // never leave the armed hero hidden if motion cannot run
  function fzRevealStatic() {
    document
      .querySelector<HTMLElement>("[data-fz-hero]")
      ?.classList.remove("is-armed");
  }

  async function initFliz() {
    const root = document.querySelector<HTMLElement>("[data-fliz]");
    if (!root) return; // not the FLIZ page
    if (fz || fzBooting) return; // already up / booting
    // ?nofz previews the static / reduced-motion fallback (no Lenis, no GSAP)
    if (
      new URLSearchParams(location.search).has("nofz") ||
      matchMedia("(prefers-reduced-motion: reduce)").matches
    ) {
      fzRevealStatic();
      return;
    }
    fzBooting = true;
    try {
      const [{ gsap }, stMod, lenisMod] = await Promise.all([
        import("gsap"),
        import("gsap/ScrollTrigger"),
        import("lenis"),
      ]);
      // a fast nav away could have dropped the page mid-import
      if (!document.querySelector("[data-fliz]")) {
        fzBooting = false;
        return;
      }
      const ScrollTrigger = (stMod as any).ScrollTrigger || (stMod as any).default;
      const Lenis = (lenisMod as any).default;
      gsap.registerPlugin(ScrollTrigger);

      // smooth scroll, driving ScrollTrigger from Lenis (per the brief)
      const lenis = new Lenis({ lerp: 0.1, smoothWheel: true });
      lenis.on("scroll", ScrollTrigger.update);
      const ticker = (t: number) => lenis.raf(t * 1000);
      gsap.ticker.add(ticker);
      gsap.ticker.lagSmoothing(0);

      root.classList.add("fz-motion");
      fz = { lenis, ticker, gsap, ScrollTrigger };

      // FLIZ uses the shared case hero (typewriter title), so there is no
      // bespoke hero animation here — the Emote layer starts at the body.

      // 1) heading colour-wipe, once
      gsap.utils.toArray<HTMLElement>("[data-fliz] .prose h2").forEach((h) => {
        gsap.fromTo(
          h,
          { "--wipe": 0 },
          {
            "--wipe": 1,
            duration: 0.9,
            ease: "power3.inOut",
            scrollTrigger: { trigger: h, start: "top 84%", once: true },
          }
        );
      });

      // 3) staggered reveal of grouped cards (marketing + status)
      gsap.utils.toArray<HTMLElement>("[data-fz-in]").forEach((group) => {
        const kids = Array.from(group.children) as HTMLElement[];
        gsap.from(kids, {
          y: 26,
          opacity: 0,
          duration: 0.7,
          ease: "power3.out",
          stagger: 0.1,
          scrollTrigger: { trigger: group, start: "top 82%", once: true },
        });
      });

      // 4) KPI: pin the moment, stagger the cards, count up (sample values only)
      const kpiPin = document.querySelector<HTMLElement>("[data-fz-kpi]");
      if (kpiPin && window.innerWidth > 720) {
        ScrollTrigger.create({
          trigger: kpiPin,
          start: "top 20%",
          end: "+=52%",
          pin: true,
          pinSpacing: true,
          anticipatePin: 1,
        });
      }
      const kpiCards = gsap.utils.toArray<HTMLElement>(".fz-kpi__card");
      if (kpiCards.length) {
        gsap.from(kpiCards, {
          y: 24,
          opacity: 0,
          duration: 0.6,
          ease: "power3.out",
          stagger: 0.08,
          scrollTrigger: { trigger: ".fz-kpi", start: "top 80%", once: true },
        });
      }
      // counters: animate 0 -> the exact value already printed in the markup
      const makeFmt = (dec: number, euro: boolean) =>
        new Intl.NumberFormat(euro ? "de-DE" : "en-US", {
          minimumFractionDigits: dec,
          maximumFractionDigits: dec,
        });
      gsap.utils.toArray<HTMLElement>("[data-fz-count]").forEach((el) => {
        const to = parseFloat(el.dataset.countTo || "0");
        const dec = parseInt(el.dataset.countDec || "0", 10);
        const euro = el.dataset.countEuro === "1";
        const prefix = euro ? "€ " : "";
        const suffix = el.dataset.countSuffix || "";
        const fmt = makeFmt(dec, euro);
        const state = { v: 0 };
        const write = (n: number) =>
          (el.textContent = prefix + fmt.format(n) + suffix);
        gsap.to(state, {
          v: to,
          duration: 1.4,
          ease: "power2.out",
          scrollTrigger: { trigger: el, start: "top 88%", once: true },
          onUpdate: () => write(state.v),
          onComplete: () => write(to),
        });
      });

      // 5) horizontal gallery: pin + scrub, contained to the column
      const gallery = document.querySelector<HTMLElement>("[data-fz-gallery]");
      const track = gallery?.querySelector<HTMLElement>("[data-fz-track]");
      if (gallery && track && window.innerWidth > 720) {
        const dist = () => Math.max(0, track.scrollWidth - gallery.offsetWidth);
        gsap.to(track, {
          x: () => -dist(),
          ease: "none",
          scrollTrigger: {
            trigger: gallery,
            start: "center center",
            end: () => "+=" + dist(),
            scrub: 0.6,
            pin: true,
            anticipatePin: 1,
            invalidateOnRefresh: true,
          },
        });
      }

      // 6) framed-screenshot parallax
      gsap.utils.toArray<HTMLElement>("[data-fz-parallax]").forEach((fig) => {
        const img = fig.querySelector<HTMLElement>("img");
        const frame = fig.querySelector<HTMLElement>(".fz-browser");
        if (!img || !frame) return;
        if (fig.classList.contains("fz-shot--tall")) {
          // tall: scroll the whole screenshot inside the capped frame
          const bar = frame.querySelector<HTMLElement>(".fz-browser__bar");
          gsap.fromTo(
            img,
            { y: 0 },
            {
              y: () => {
                const barH = bar ? bar.offsetHeight : 0;
                return -Math.max(0, img.offsetHeight - (frame.clientHeight - barH));
              },
              ease: "none",
              scrollTrigger: {
                trigger: fig,
                start: "top bottom",
                end: "bottom top",
                scrub: true,
                invalidateOnRefresh: true,
              },
            }
          );
        } else {
          // short: gentle whole-image drift
          gsap.fromTo(
            img,
            { yPercent: -4 },
            {
              yPercent: 4,
              ease: "none",
              scrollTrigger: {
                trigger: fig,
                start: "top bottom",
                end: "bottom top",
                scrub: true,
              },
            }
          );
        }
      });

      // settle triggers once fonts + images have influenced layout
      const refresh = () => ScrollTrigger.refresh();
      (document as any).fonts?.ready?.then(refresh);
      window.addEventListener("load", refresh, { once: true });
      root.querySelectorAll("img").forEach((im) => {
        if (!(im as HTMLImageElement).complete)
          im.addEventListener("load", refresh, { once: true });
      });
      setTimeout(refresh, 500);
    } catch (err) {
      fzRevealStatic(); // motion failed to load: keep the page readable
    } finally {
      fzBooting = false;
    }
  }

  function teardownFliz() {
    document
      .querySelector<HTMLElement>("[data-fliz]")
      ?.classList.remove("fz-motion");
    if (!fz) return;
    try {
      fz.ScrollTrigger.getAll().forEach((t: any) => t.kill());
    } catch {}
    try {
      fz.gsap.ticker.remove(fz.ticker);
    } catch {}
    try {
      fz.lenis.destroy();
    } catch {}
    fz = null;
  }

  document.addEventListener("astro:before-swap", teardownFliz);
  initFliz();
  document.addEventListener("astro:page-load", initFliz);
</script>

<script>
  // Shelly 2026 act: three interactive phone demos (.shd). Vanilla only, in
  // the house style: CSS keyframes for the idle mascot, the Web Animations
  // API for the breathing circle, IntersectionObserver to start on view and
  // pause off-screen. Reduced motion: static states, instant counters,
  // text-only breathing cues. Torn down on every view-transition swap.
  let shdInited = false;
  let shdIO: IntersectionObserver | null = null;
  let shdTimers: number[] = [];
  let shdRafs: number[] = [];
  let shdAnims: Animation[] = [];

  function shdTeardown() {
    shdTimers.forEach((t) => { clearTimeout(t); clearInterval(t); });
    shdRafs.forEach((r) => cancelAnimationFrame(r));
    shdAnims.forEach((a) => { try { a.cancel(); } catch {} });
    shdIO?.disconnect();
    shdIO = null; shdTimers = []; shdRafs = []; shdAnims = [];
    shdInited = false;
  }

  function initShd() {
    if (shdInited) return;
    const roots = Array.from(document.querySelectorAll<HTMLElement>(".shd"));
    if (!roots.length) return;
    shdInited = true;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

    const show = (root: HTMLElement, id: string) => {
      root.querySelectorAll<HTMLElement>(".shd-screen").forEach((s) => {
        s.classList.toggle("is-on", s.dataset.s === id || (!s.dataset.s && id === "0"));
      });
    };

    // ---- demo 1: check-in ----
    const orders: Record<string, string[]> = {
      packed: ["breathe", "stretch", "walk"],
      normal: ["breathe", "walk", "stretch"],
      open: ["walk", "breathe", "stretch"],
    };
    const heroes: Record<string, string> = { packed: "breathe", open: "walk", normal: "" };

    function pickDay(root: HTMLElement, day: string) {
      const pills = Array.from(root.querySelectorAll<HTMLElement>(".shd-pill"));
      pills.forEach((p) => {
        p.classList.remove("is-in", "is-hero");
        p.style.order = String(orders[day].indexOf(p.dataset.k || ""));
        if (heroes[day] === p.dataset.k) p.classList.add("is-hero");
      });
      show(root, "2");
      const sorted = pills.slice().sort((a, b) => Number(a.style.order) - Number(b.style.order));
      sorted.forEach((p, i) => {
        if (reduce) { p.classList.add("is-in"); return; }
        shdTimers.push(window.setTimeout(() => p.classList.add("is-in"), 140 + i * 110));
      });
    }

    // ---- demo 2: week (arm now, play on first view, once per page visit) ----
    function armWeek(root: HTMLElement) {
      if (reduce) return; // poster stays final: instant counter, fills visible
      const num = root.querySelector<HTMLElement>(".shd-num");
      if (num) num.textContent = "0";
    }
    function playWeek(root: HTMLElement) {
      if (root.dataset.played) return;
      root.dataset.played = "1";
      const num = root.querySelector<HTMLElement>(".shd-num");
      const fills = Array.from(root.querySelectorAll<HTMLElement>(".shd-fill"));
      const msg = root.querySelector<HTMLElement>(".shd-msg");
      const sh = root.querySelector<HTMLElement>(".sh");
      if (reduce) {
        fills.forEach((f) => f.classList.add("is-on"));
        msg?.classList.add("is-on");
        return;
      }
      const target = 189, dur = 1200, t0 = performance.now();
      const step = (now: number) => {
        const p = Math.min(1, (now - t0) / dur);
        if (num) num.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))));
        if (p < 1) { shdRafs.push(requestAnimationFrame(step)); return; }
        fills.forEach((f, i) =>
          shdTimers.push(window.setTimeout(() => f.classList.add("is-on"), 250 + i * 380)));
        shdTimers.push(window.setTimeout(() => {
          msg?.classList.add("is-on");
          sh?.classList.add("sh-wave");
        }, 250 + fills.length * 380 + 250));
      };
      shdRafs.push(requestAnimationFrame(step));
    }

    // ---- demo 3: breathing ----
    interface BreathState {
      paused: boolean; auto: boolean; done: boolean;
      base: number; t0: number; anim: Animation | null; iv: number;
    }
    const breathStates = new WeakMap<HTMLElement, BreathState>();
    const fmt = (t: number) => {
      const sec = Math.max(0, 60 - Math.floor(t / 1000));
      return sec === 60 ? "1:00" : "0:" + String(sec).padStart(2, "0");
    };
    const elapsed = (s: BreathState) => {
      if (s.anim) return Number(s.anim.currentTime) || 0;
      return s.paused ? s.base : s.base + (performance.now() - s.t0);
    };
    function endBreathSession(root: HTMLElement) {
      const s = breathStates.get(root);
      if (!s) return;
      s.done = true;
      clearInterval(s.iv);
      try { s.anim?.cancel(); } catch {}
      breathStates.delete(root);
    }
    function finishBreath(root: HTMLElement) {
      const s = breathStates.get(root);
      if (!s || s.done) return;
      endBreathSession(root);
      show(root, "2");
      const plus = root.querySelector<HTMLElement>(".shd-plus");
      if (plus && !reduce) {
        shdAnims.push(plus.animate(
          [
            { opacity: 0, transform: "translateY(10px) scale(0.6)" },
            { opacity: 1, transform: "translateY(-4px) scale(1.15)", offset: 0.7 },
            { opacity: 1, transform: "translateY(0) scale(1)" },
          ],
          { duration: 650, easing: "ease-out" }
        ));
      }
    }
    function startBreath(root: HTMLElement) {
      endBreathSession(root);
      show(root, "1");
      const circle = root.querySelector<HTMLElement>(".shd-circle");
      const cue = root.querySelector<HTMLElement>(".shd-cue");
      const time = root.querySelector<HTMLElement>(".shd-time");
      if (!circle || !cue || !time) return;
      cue.textContent = "Breathe in";
      time.textContent = "1:00";
      const s: BreathState = { paused: false, auto: false, done: false, base: 0, t0: performance.now(), anim: null, iv: 0 };
      if (!reduce) {
        s.anim = circle.animate(
          [{ transform: "scale(1)" }, { transform: "scale(1.22)" }],
          { duration: 4000, iterations: 15, direction: "alternate", easing: "ease-in-out" }
        );
        shdAnims.push(s.anim);
        s.anim.onfinish = () => finishBreath(root);
      }
      s.iv = window.setInterval(() => {
        if (s.done || s.paused) return;
        const t = elapsed(s);
        if (t >= 60000) { finishBreath(root); return; }
        time.textContent = fmt(t);
        cue.textContent = Math.floor(t / 4000) % 2 === 0 ? "Breathe in" : "Breathe out";
      }, 250);
      shdTimers.push(s.iv);
      breathStates.set(root, s);
    }
    function pauseBreath(root: HTMLElement, auto: boolean) {
      const s = breathStates.get(root);
      if (!s || s.done || s.paused) return;
      s.paused = true; s.auto = auto;
      if (s.anim) s.anim.pause();
      else { s.base = s.base + (performance.now() - s.t0); }
    }
    function resumeBreath(root: HTMLElement, auto: boolean) {
      const s = breathStates.get(root);
      if (!s || s.done || !s.paused) return;
      if (auto && !s.auto) return; // a user pause survives scrolling away
      s.paused = false; s.auto = false;
      if (s.anim) s.anim.play();
      else s.t0 = performance.now();
    }

    // ---- wiring ----
    roots.forEach((root) => {
      root.classList.add("is-live");
      const kind = root.dataset.shd;
      if (kind === "week") armWeek(root);
      root.addEventListener("click", (e) => {
        const btn = (e.target as HTMLElement).closest("button");
        if (!btn || !root.contains(btn)) return;
        if (kind === "checkin") {
          if (btn.dataset.go === "1" || btn.classList.contains("shd-reset")) { show(root, "1"); return; }
          if (btn.classList.contains("shd-opt")) { pickDay(root, btn.dataset.day || "normal"); }
          return;
        }
        if (kind === "breath") {
          if (btn.dataset.go === "breathe") { startBreath(root); return; }
          if (btn.classList.contains("shd-circle")) {
            const s = breathStates.get(root);
            if (!s || s.done) return;
            if (s.paused) resumeBreath(root, false); else pauseBreath(root, false);
            return;
          }
          if (btn.classList.contains("shd-reset")) { endBreathSession(root); show(root, "0"); }
        }
      });
    });

    shdIO = new IntersectionObserver(
      (entries) => {
        entries.forEach((en) => {
          const root = en.target as HTMLElement;
          root.classList.toggle("shd-off", !en.isIntersecting);
          if (en.isIntersecting) {
            if (!root.dataset.seen) {
              root.dataset.seen = "1";
              if (root.dataset.shd === "checkin" && !reduce)
                root.querySelector(".sh")?.classList.add("sh-wave");
              if (root.dataset.shd === "week") playWeek(root);
            }
            if (root.dataset.shd === "breath") resumeBreath(root, true);
          } else if (root.dataset.shd === "breath") {
            pauseBreath(root, true);
          }
        });
      },
      { threshold: 0.35 }
    );
    roots.forEach((r) => shdIO!.observe(r));
  }

  document.addEventListener("astro:before-swap", shdTeardown);
  initShd();
  document.addEventListener("astro:page-load", initShd);
</script>
