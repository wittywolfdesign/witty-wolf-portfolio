<script>
  // Stamp choreography: curtain lifts, the title types itself, then the
  // stamp lands (quick snap) and the curly ink lines draw over it. The
  // title's TypeLine dispatches tw-done when it finishes; a generous
  // timeout backstops it. Reduced motion or no JS: static, already there.
  let stampInited = false;
  function initStamp() {
    if (stampInited) return;
    const el = document.querySelector<HTMLElement>("[data-stamp]");
    if (!el) return;
    stampInited = true;
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
      el.style.visibility = "";
      return;
    }
    el.classList.add("is-armed");
    let landed = false;
    const land = () => {
      if (landed) return;
      landed = true;
      el.style.visibility = "";
      el.classList.add("is-stamped");
      window.setTimeout(() => el.classList.add("is-in"), 180);
    };
    document
      .querySelector(".case-title")
      ?.addEventListener("tw-done", () => window.setTimeout(land, 200), { once: true });
    window.setTimeout(land, 7000);
  }
  document.addEventListener("astro:before-swap", () => (stampInited = false));
  initStamp();
  document.addEventListener("astro:page-load", initStamp);

  // Build-stage skyline header: the divider + heading wipe in together when
  // the group enters the viewport (and replay on hover, via CSS). Armed by JS
  // so no-JS visitors see it fully revealed; reduced motion stays static.
  function initSkylines() {
    const heads = document.querySelectorAll<HTMLElement>(".skyline-head");
    if (!heads.length) return;
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const io = new IntersectionObserver(
      (entries, obs) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add("in-view");
            obs.unobserve(e.target);
          }
        }
      },
      { threshold: 0.4 },
    );
    heads.forEach((h) => {
      h.classList.add("reveal-ready");
      io.observe(h);
    });
  }
  initSkylines();
  document.addEventListener("astro:page-load", initSkylines);

  // "Look closer" enlarge hint: drop a small label into every click-to-enlarge
  // figure. JS-only by design, it advertises the lightbox, which itself needs
  // JS, so no-JS visitors correctly see neither. Idempotent, re-runs per page.
  function initZoomHints() {
    // the label speaks the page's language; it rides on the article's data
    // attribute so this shared script needs no locale knowledge of its own
    const label =
      document.querySelector<HTMLElement>(".case")?.dataset.uiLookcloser ?? "Look closer";
    document.querySelectorAll<HTMLElement>(".prose .fig").forEach((fig) => {
      if (!fig.querySelector("img") || fig.querySelector(".fig__zoom")) return;
      const hint = document.createElement("span");
      hint.className = "fig__zoom";
      hint.setAttribute("aria-hidden", "true");
      const text = document.createElement("span");
      text.className = "fig__zoom-t";
      text.textContent = label;
      hint.appendChild(text);
      fig.appendChild(hint);
    });
  }
  initZoomHints();
  document.addEventListener("astro:page-load", initZoomHints);

  // Click-to-enlarge lightbox for case-study images. GOTCHA: Astro's
  // ClientRouter replaces <body> on a view transition, so an overlay appended
  // to <body> once is DETACHED after the first in-site navigation and clicks
  // then open a box that is not in the DOM (nothing shows). So the overlay is
  // (re)created per page via ensureBox(), while the delegated click/key
  // listeners are registered once on document. Close via the button, a
  // backdrop click, or Escape.
  interface LightboxWindow extends Window { __caseLightbox?: boolean }
  (() => {
    const w = window as unknown as LightboxWindow;
    let lastFocus: HTMLElement | null = null;

    function ensureBox(): HTMLElement {
      const existing = document.querySelector<HTMLElement>(".lightbox");
      if (existing) return existing;
      const box = document.createElement("div");
      box.className = "lightbox";
      box.setAttribute("role", "dialog");
      box.setAttribute("aria-modal", "true");
      box.setAttribute("aria-hidden", "true");
      const closeLabel =
        document.querySelector<HTMLElement>(".case")?.dataset.uiClose ?? "Close";
      box.innerHTML =
        `<button class="lightbox__close" type="button" aria-label="${closeLabel}">×</button>` +
        '<img class="lightbox__img" alt="" />' +
        '<p class="lightbox__cap"></p>';
      document.body.appendChild(box);
      // close: backdrop click (the overlay itself) or the close button
      box.addEventListener("click", (e) => { if (e.target === box) close(); });
      box.querySelector<HTMLButtonElement>(".lightbox__close")!.addEventListener("click", close);
      return box;
    }

    function open(src: string, alt: string, cap: string) {
      const box = ensureBox();
      const imgEl = box.querySelector(".lightbox__img") as HTMLImageElement;
      const capEl = box.querySelector(".lightbox__cap") as HTMLElement;
      imgEl.src = src;
      imgEl.alt = alt;
      capEl.textContent = cap;
      capEl.style.display = cap ? "" : "none";
      lastFocus = document.activeElement as HTMLElement;
      box.classList.add("is-open");
      box.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      (box.querySelector(".lightbox__close") as HTMLElement).focus();
    }
    function close() {
      const box = document.querySelector<HTMLElement>(".lightbox");
      if (!box) return;
      box.classList.remove("is-open");
      box.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      lastFocus?.focus();
    }

    // register the global listeners once (they survive view transitions)
    if (!w.__caseLightbox) {
      w.__caseLightbox = true;
      // open: delegated click on any case image OR its "Look closer" hint. The
      // hint sits over the caption row, not the image, so resolve it back to the
      // figure's visible <img> (theme-swap figures keep two).
      document.addEventListener("click", (e) => {
        const t = e.target as HTMLElement;
        let img = t.closest(".prose .fig img") as HTMLImageElement | null;
        if (!img) {
          const fig = t.closest(".prose .fig .fig__zoom")?.closest(".fig");
          if (fig) {
            const imgs = Array.from(fig.querySelectorAll<HTMLImageElement>("img"));
            img = imgs.find((i) => i.offsetParent !== null) ?? imgs[0] ?? null;
          }
        }
        if (!img) return;
        const cap = img.closest(".fig")?.querySelector("figcaption")?.textContent?.trim() ?? "";
        open(img.currentSrc || img.src, img.alt || "", cap);
      });
      document.addEventListener("keydown", (e) => {
        const box = document.querySelector(".lightbox");
        if (e.key === "Escape" && box && box.classList.contains("is-open")) close();
      });
    }

    // ensure the overlay is present on this page, and re-create it after every
    // view-transition swap (which drops the previous one from <body>)
    ensureBox();
    document.addEventListener("astro:page-load", ensureBox);
  })();
</script>

<script>
  // FLIZ Emote-style scroll layer. Loaded ONLY on the FLIZ case (guarded on
  // [data-fliz]); GSAP + Lenis come in via dynamic import(), so they are a
  // separate chunk that never ships to any other case page. Torn down on
  // navigation away; fully skipped under prefers-reduced-motion.
  interface FzCtx {
    lenis: any;
    ticker: (t: number) => void;
    gsap: any;
    ScrollTrigger: any;
  }
  let fz: FzCtx | null = null;
  let fzBooting = false;

  // never leave the armed hero hidden if motion cannot run
  function fzRevealStatic() {
    document
      .querySelector<HTMLElement>("[data-fz-hero]")
      ?.classList.remove("is-armed");
  }

  async function initFliz() {
    const root = document.querySelector<HTMLElement>("[data-fliz]");
    if (!root) return; // not the FLIZ page
    if (fz || fzBooting) return; // already up / booting
    // ?nofz previews the static / reduced-motion fallback (no Lenis, no GSAP)
    if (
      new URLSearchParams(location.search).has("nofz") ||
      matchMedia("(prefers-reduced-motion: reduce)").matches
    ) {
      fzRevealStatic();
      return;
    }
    fzBooting = true;
    try {
      const [{ gsap }, stMod, lenisMod] = await Promise.all([
        import("gsap"),
        import("gsap/ScrollTrigger"),
        import("lenis"),
      ]);
      // a fast nav away could have dropped the page mid-import
      if (!document.querySelector("[data-fliz]")) {
        fzBooting = false;
        return;
      }
      const ScrollTrigger = (stMod as any).ScrollTrigger || (stMod as any).default;
      const Lenis = (lenisMod as any).default;
      gsap.registerPlugin(ScrollTrigger);

      // smooth scroll, driving ScrollTrigger from Lenis (per the brief)
      const lenis = new Lenis({ lerp: 0.1, smoothWheel: true });
      lenis.on("scroll", ScrollTrigger.update);
      const ticker = (t: number) => lenis.raf(t * 1000);
      gsap.ticker.add(ticker);
      gsap.ticker.lagSmoothing(0);

      root.classList.add("fz-motion");
      fz = { lenis, ticker, gsap, ScrollTrigger };

      // FLIZ uses the shared case hero (typewriter title), so there is no
      // bespoke hero animation here — the Emote layer starts at the body.

      // 1) heading colour-wipe, once
      gsap.utils.toArray<HTMLElement>("[data-fliz] .prose h2").forEach((h) => {
        gsap.fromTo(
          h,
          { "--wipe": 0 },
          {
            "--wipe": 1,
            duration: 0.9,
            ease: "power3.inOut",
            scrollTrigger: { trigger: h, start: "top 84%", once: true },
          }
        );
      });

      // 3) staggered reveal of grouped cards (marketing + status)
      gsap.utils.toArray<HTMLElement>("[data-fz-in]").forEach((group) => {
        const kids = Array.from(group.children) as HTMLElement[];
        gsap.from(kids, {
          y: 26,
          opacity: 0,
          duration: 0.7,
          ease: "power3.out",
          stagger: 0.1,
          scrollTrigger: { trigger: group, start: "top 82%", once: true },
        });
      });

      // 4) KPI: pin the moment, stagger the cards, count up (sample values only)
      const kpiPin = document.querySelector<HTMLElement>("[data-fz-kpi]");
      if (kpiPin && window.innerWidth > 720) {
        ScrollTrigger.create({
          trigger: kpiPin,
          start: "top 20%",
          end: "+=52%",
          pin: true,
          pinSpacing: true,
          anticipatePin: 1,
        });
      }
      const kpiCards = gsap.utils.toArray<HTMLElement>(".fz-kpi__card");
      if (kpiCards.length) {
        gsap.from(kpiCards, {
          y: 24,
          opacity: 0,
          duration: 0.6,
          ease: "power3.out",
          stagger: 0.08,
          scrollTrigger: { trigger: ".fz-kpi", start: "top 80%", once: true },
        });
      }
      // counters: animate 0 -> the exact value already printed in the markup
      const makeFmt = (dec: number, euro: boolean) =>
        new Intl.NumberFormat(euro ? "de-DE" : "en-US", {
          minimumFractionDigits: dec,
          maximumFractionDigits: dec,
        });
      gsap.utils.toArray<HTMLElement>("[data-fz-count]").forEach((el) => {
        const to = parseFloat(el.dataset.countTo || "0");
        const dec = parseInt(el.dataset.countDec || "0", 10);
        const euro = el.dataset.countEuro === "1";
        const prefix = euro ? "€ " : "";
        const suffix = el.dataset.countSuffix || "";
        const fmt = makeFmt(dec, euro);
        const state = { v: 0 };
        const write = (n: number) =>
          (el.textContent = prefix + fmt.format(n) + suffix);
        gsap.to(state, {
          v: to,
          duration: 1.4,
          ease: "power2.out",
          scrollTrigger: { trigger: el, start: "top 88%", once: true },
          onUpdate: () => write(state.v),
          onComplete: () => write(to),
        });
      });

      // 5) horizontal gallery: pin + scrub, contained to the column
      const gallery = document.querySelector<HTMLElement>("[data-fz-gallery]");
      const track = gallery?.querySelector<HTMLElement>("[data-fz-track]");
      if (gallery && track && window.innerWidth > 720) {
        const dist = () => Math.max(0, track.scrollWidth - gallery.offsetWidth);
        gsap.to(track, {
          x: () => -dist(),
          ease: "none",
          scrollTrigger: {
            trigger: gallery,
            start: "center center",
            end: () => "+=" + dist(),
            scrub: 0.6,
            pin: true,
            anticipatePin: 1,
            invalidateOnRefresh: true,
          },
        });
      }

      // 6) framed-screenshot parallax
      gsap.utils.toArray<HTMLElement>("[data-fz-parallax]").forEach((fig) => {
        const img = fig.querySelector<HTMLElement>("img");
        const frame = fig.querySelector<HTMLElement>(".fz-browser");
        if (!img || !frame) return;
        if (fig.classList.contains("fz-shot--tall")) {
          // tall: scroll the whole screenshot inside the capped frame
          const bar = frame.querySelector<HTMLElement>(".fz-browser__bar");
          gsap.fromTo(
            img,
            { y: 0 },
            {
              y: () => {
                const barH = bar ? bar.offsetHeight : 0;
                return -Math.max(0, img.offsetHeight - (frame.clientHeight - barH));
              },
              ease: "none",
              scrollTrigger: {
                trigger: fig,
                start: "top bottom",
                end: "bottom top",
                scrub: true,
                invalidateOnRefresh: true,
              },
            }
          );
        } else {
          // short: gentle whole-image drift
          gsap.fromTo(
            img,
            { yPercent: -4 },
            {
              yPercent: 4,
              ease: "none",
              scrollTrigger: {
                trigger: fig,
                start: "top bottom",
                end: "bottom top",
                scrub: true,
              },
            }
          );
        }
      });

      // settle triggers once fonts + images have influenced layout
      const refresh = () => ScrollTrigger.refresh();
      (document as any).fonts?.ready?.then(refresh);
      window.addEventListener("load", refresh, { once: true });
      root.querySelectorAll("img").forEach((im) => {
        if (!(im as HTMLImageElement).complete)
          im.addEventListener("load", refresh, { once: true });
      });
      setTimeout(refresh, 500);
    } catch (err) {
      fzRevealStatic(); // motion failed to load: keep the page readable
    } finally {
      fzBooting = false;
    }
  }

  function teardownFliz() {
    document
      .querySelector<HTMLElement>("[data-fliz]")
      ?.classList.remove("fz-motion");
    if (!fz) return;
    try {
      fz.ScrollTrigger.getAll().forEach((t: any) => t.kill());
    } catch {}
    try {
      fz.gsap.ticker.remove(fz.ticker);
    } catch {}
    try {
      fz.lenis.destroy();
    } catch {}
    fz = null;
  }

  document.addEventListener("astro:before-swap", teardownFliz);
  initFliz();
  document.addEventListener("astro:page-load", initFliz);
</script>

<script>
  // Shelly journal act (.sj): six live Field Journal screens, held in the
  // "Redrawn, 2026" strip. Vanilla only. Handles the ink-in reveal (once
  // per screen, on scroll into view), the screens' real interactions
  // (draggable sliders, presses, the dashboard switch, the exercise
  // timer/pause/skip), and a handful of small self-running cadences that
  // only make sense on screens with nothing to click (the greeting's
  // pose swap, the loading word/orb cycle, the occasional hare) — each
  // gated to its OWN screen being on screen, not a shared root. Fully
  // skipped under prefers-reduced-motion, and tears down on view swaps.
  let sjTimers: number[] = [];
  let sjIOs: IntersectionObserver[] = [];
  let sjInited = false;

  function sjTeardown() {
    sjTimers.forEach((t) => clearInterval(t));
    sjIOs.forEach((io) => io.disconnect());
    sjTimers = []; sjIOs = [];
    sjInited = false;
  }

  function sjBerrySVG() {
    return '<svg class="sj-berry" viewBox="0 0 24 27" aria-hidden="true"><path class="s-berry s-line" d="M12 25C6 25 2.6 19.4 2.6 14.2 2.6 9.6 6.2 7.4 12 7.4s9.4 2.2 9.4 6.8C21.4 19.4 18 25 12 25Z"/><path class="s-leaf s-line" d="M12 7.6C10 5 7.4 4.1 5 4.6 6.8 7 9.2 8 12 7.6Zm0 0c2-2.6 4.6-3.5 7-3C17.2 7 14.8 8 12 7.6Z"/><path class="s-stem s-line" d="M12 7.2 Q11.4 4.4 12.6 2.4"/><circle class="s-seed" cx="8" cy="13.4" r="1"/><circle class="s-seed" cx="16" cy="13.4" r="1"/><circle class="s-seed" cx="12" cy="17.6" r="1"/></svg>';
  }
  function sjHareSVG() {
    return '<svg viewBox="0 0 90 56" aria-hidden="true"><ellipse class="h-wash" cx="42" cy="34" rx="26" ry="12" transform="rotate(-6 42 34)"/><path class="sjl" d="M14 42 Q18 26 40 25 Q60 24 70 30"/><path class="sjl" d="M20 44 Q40 50 62 42"/><ellipse class="sjl" cx="66" cy="12" rx="3.5" ry="9" transform="rotate(-28 66 12)"/><ellipse class="sjl" cx="72" cy="11" rx="3.5" ry="9" transform="rotate(-12 72 11)"/><circle class="sjl" cx="74" cy="26" r="7"/><circle class="h-eye" cx="75.5" cy="24" r="1.3"/><path class="sjl" d="M81 27.5 l4 1"/><circle class="sjl" cx="13" cy="38" r="4"/><path class="sjl" d="M20 42 Q10 50 2 48"/><path class="sjl" d="M26 44 Q22 52 14 53"/><path class="sjl" d="M58 40 Q66 48 76 46"/><path class="sjl" d="M64 37 Q74 40 82 36"/></svg>';
  }

  function initSj() {
    if (sjInited) return;
    sjInited = true;
    const REDUCE = matchMedia("(prefers-reduced-motion: reduce)").matches;

    // ---- ink-in reveal + a shared per-screen visibility map, so the
    // cadences below (pose swap, hare, loading cycle) only run while
    // their own screen is actually on screen ----
    const scenes = document.querySelectorAll<HTMLElement>(".sj-compare");
    const sceneVisible = new Map<Element, boolean>();
    const isVisible = (el: HTMLElement) => {
      const scene = el.closest(".sj-compare");
      return scene ? sceneVisible.get(scene) === true : false;
    };
    if (scenes.length) {
      if (REDUCE) {
        scenes.forEach((sc) => { sc.classList.add("sj-play"); sceneVisible.set(sc, true); });
      } else {
        const gate = new IntersectionObserver(
          (entries) => entries.forEach((en) => {
            sceneVisible.set(en.target, en.isIntersecting);
            if (en.isIntersecting) en.target.classList.add("sj-play");
          }),
          { threshold: 0.12 },
        );
        scenes.forEach((sc) => { sceneVisible.set(sc, false); gate.observe(sc); });
        sjIOs.push(gate);
      }
    }

    // ---- sliders: drag or arrow-key, for real ----
    document.querySelectorAll<HTMLElement>(".sj-slider").forEach((sl) => {
      const vals = (sl.dataset.vals || "").split(",");
      const steps = vals.length - 1;
      const track = sl.querySelector<HTMLElement>(".sj-track")!;
      const handle = sl.querySelector<HTMLElement>(".sj-handle")!;
      const fill = sl.querySelector<HTMLElement>(".sj-fill")!;
      let idx = parseInt(sl.dataset.start || "0", 10);
      const render = () => {
        const p = idx / steps;
        handle.style.setProperty("--px", p * track.clientWidth + "px");
        fill.style.setProperty("--p", String(Math.max(p, 0.02)));
      };
      new ResizeObserver(render).observe(track);
      const toIdx = (clientX: number) => {
        const r = track.getBoundingClientRect();
        idx = Math.round(Math.min(1, Math.max(0, (clientX - r.left) / r.width)) * steps);
        render();
      };
      handle.addEventListener("pointerdown", (e) => {
        handle.setPointerCapture(e.pointerId);
      });
      handle.addEventListener("pointermove", (e) => {
        if (handle.hasPointerCapture(e.pointerId)) toIdx(e.clientX);
      });
      handle.addEventListener("keydown", (e) => {
        if (e.key === "ArrowRight" || e.key === "ArrowUp") { idx = Math.min(steps, idx + 1); render(); e.preventDefault(); }
        if (e.key === "ArrowLeft" || e.key === "ArrowDown") { idx = Math.max(0, idx - 1); render(); e.preventDefault(); }
      });
      render();
    });

    // ---- press ripple + strawberry firework + peace pose ----
    function pressButton(btn: HTMLElement) {
      btn.classList.add("sj-press");
      const ring = document.createElement("span");
      ring.className = "sj-tapring";
      const phone = btn.closest<HTMLElement>(".sj-phone")!;
      const r = btn.getBoundingClientRect();
      const pr = phone.getBoundingClientRect();
      const sc = pr.width / phone.offsetWidth; // the phone is scaled
      ring.style.left = (r.left - pr.left) / sc + r.width / sc * 0.62 - 17 + "px";
      ring.style.top = (r.top - pr.top) / sc + r.height / sc * 0.7 - 17 + "px";
      phone.appendChild(ring);
      window.setTimeout(() => ring.remove(), 550);
      window.setTimeout(() => btn.classList.remove("sj-press"), 320);
    }
    function rainAndPeace(btn: HTMLElement) {
      pressButton(btn);
      const phone = btn.closest<HTMLElement>(".sj-phone")!;
      const layer = phone.querySelector<HTMLElement>(".sj-rain");
      if (!layer) return;
      const sc = phone.getBoundingClientRect().width / phone.offsetWidth;
      const br = btn.getBoundingClientRect();
      const pr = layer.getBoundingClientRect();
      const ox = (br.left - pr.left + br.width / 2) / sc;
      const oy = (br.top - pr.top + br.height / 2) / sc;
      for (let i = 0; i < 10; i++) {
        const b = document.createElement("span");
        b.className = "sj-rainberry";
        b.innerHTML = sjBerrySVG();
        const ang = (-90 + (Math.random() * 150 - 75)) * (Math.PI / 180);
        const dist = 60 + Math.random() * 85;
        b.style.left = ox + "px";
        b.style.top = oy + "px";
        b.style.setProperty("--tx", (Math.cos(ang) * dist).toFixed(0) + "px");
        b.style.setProperty("--ty", (Math.sin(ang) * dist).toFixed(0) + "px");
        b.style.setProperty("--s", 14 + Math.random() * 10 + "px");
        b.style.setProperty("--dl", Math.random() * 0.3 + "s");
        b.style.setProperty("--dur", 1.5 + Math.random() * 0.7 + "s");
        b.style.setProperty("--r", Math.random() * 90 - 45 + "deg");
        layer.appendChild(b);
        window.setTimeout(() => b.remove(), 2800);
      }
      const wave = phone.querySelector<HTMLElement>('[data-pose="wave"]');
      const peace = phone.querySelector<HTMLElement>('[data-pose="peace"]');
      if (!wave || !peace) return;
      wave.classList.add("sj-hide");
      peace.classList.remove("sj-hide");
      window.setTimeout(() => {
        peace.classList.add("sj-hide");
        wave.classList.remove("sj-hide");
      }, 3000);
    }
    document.querySelectorAll<HTMLElement>("[data-sj-press]").forEach((btn) =>
      btn.addEventListener("click", () => { if (!REDUCE) rainAndPeace(btn); }));

    // ---- exercise: countdown + pause (flipbook pauses with it) ----
    const xstate = { t: 72, paused: false };
    const xtimer = document.querySelector<HTMLElement>("[data-sj-timer]");
    const xpause = document.querySelector<HTMLElement>("[data-sj-pause]");
    const xplate = document.querySelector<HTMLElement>("[data-sj-xplate]");
    const xrender = () => {
      if (!xtimer) return;
      const m = Math.floor(xstate.t / 60), s = xstate.t % 60;
      xtimer.textContent = String(m).padStart(2, "0") + ":" + String(s).padStart(2, "0");
    };
    const xtoggle = () => {
      xstate.paused = !xstate.paused;
      xpause?.classList.toggle("sj-playing", xstate.paused);
      xplate?.classList.toggle("sj-paused", xstate.paused);
    };
    if (xtimer && !REDUCE) {
      sjTimers.push(window.setInterval(() => {
        if (!isVisible(xtimer) || document.hidden || xstate.paused) return;
        xstate.t = xstate.t > 0 ? xstate.t - 1 : 90;
        xrender();
      }, 1000));
    }
    xpause?.addEventListener("click", xtoggle);
    document.querySelectorAll<HTMLElement>("[data-sj-skip]").forEach((btn) =>
      btn.addEventListener("click", () => {
        xstate.t = Math.min(90, Math.max(0, xstate.t - Number(btn.dataset.sjSkip || "0")));
        xrender();
      }));

    // ---- greeting: the pose swaps itself every so often ----
    const greetBtn = [...document.querySelectorAll<HTMLElement>("[data-sj-press]")]
      .find((btn) => btn.closest(".sj-phone")?.querySelector("[data-pose]"));
    if (greetBtn && !REDUCE) {
      sjTimers.push(window.setInterval(() => {
        if (!isVisible(greetBtn) || document.hidden) return;
        rainAndPeace(greetBtn);
      }, 8200));
    }

    // ---- the hare: dashes across whichever visible screen's background
    // happens to have a lane (greeting, loading) ----
    if (!REDUCE) {
      sjTimers.push(window.setInterval(() => {
        if (document.hidden) return;
        const lanes = [...document.querySelectorAll<HTMLElement>(".sj-hares")].filter((lane) => isVisible(lane));
        if (!lanes.length) return;
        const lane = lanes[Math.floor(Math.random() * lanes.length)];
        let hare = lane.querySelector<HTMLElement>(".sj-hare");
        if (!hare) {
          hare = document.createElement("span");
          hare.className = "sj-hare";
          hare.innerHTML = sjHareSVG();
          lane.appendChild(hare);
        }
        hare.classList.remove("sj-dash");
        void hare.offsetWidth;
        hare.classList.add("sj-dash");
      }, 6800));
    }

    // ---- loading: word trio + one-ball traffic light, one cadence ----
    const LOADWORDS = ["Loading....", "Almost....", "Ready?"];
    const WORDCOL = ["cr", "co", "cg"];
    let lwIdx = 0;
    const lwEl = document.querySelector<HTMLElement>("[data-sj-loadword]");
    const orbBox = document.querySelector<HTMLElement>(".sj-orbs");
    let orbCurrent = orbBox?.querySelector<HTMLElement>("i") ?? null;
    function makeOrb(colcls: string, x: number, scv: string, o: string) {
      const el = document.createElement("i");
      el.className = colcls;
      el.style.setProperty("--x", x + "px");
      el.style.setProperty("--sc", scv);
      el.style.setProperty("--o", o);
      orbBox!.appendChild(el);
      return el;
    }
    function pushOrb(colcls: string, onImpact: () => void) {
      if (!orbBox) return;
      const inc = makeOrb(colcls, -132, "0.92", "0");
      void inc.offsetWidth;
      inc.style.transition = "transform 0.42s cubic-bezier(0.55, 0, 0.85, 0.55), opacity 0.18s ease";
      inc.style.setProperty("--x", "-52px"); // presses INTO the sitting ball
      inc.style.setProperty("--o", "1");
      const out = orbCurrent;
      orbCurrent = inc;
      window.setTimeout(() => {
        onImpact();
        inc.style.transition = "transform 0.5s cubic-bezier(0.2, 1.25, 0.4, 1)";
        inc.style.setProperty("--x", "0px");
        inc.style.setProperty("--sc", "1.08");
        if (out) out.style.setProperty("--sc", "0.92");
        window.setTimeout(() => {
          inc.style.transition = "transform 0.3s ease-out";
          inc.style.setProperty("--sc", "1");
        }, 190);
        window.setTimeout(() => {
          if (out) {
            out.style.transition = "transform 0.55s cubic-bezier(0.1, 0.65, 0.3, 1), opacity 0.32s ease 0.2s";
            out.style.setProperty("--x", "132px");
            out.style.setProperty("--o", "0");
            window.setTimeout(() => out.remove(), 800);
          }
        }, 70);
      }, 430);
    }
    if (lwEl && orbBox && !REDUCE) {
      sjTimers.push(window.setInterval(() => {
        if (!isVisible(lwEl) || document.hidden) return;
        const next = (lwIdx + 1) % LOADWORDS.length;
        pushOrb(WORDCOL[next], () => {
          lwEl.classList.add("sj-swapw");
          window.setTimeout(() => {
            lwIdx = next;
            lwEl.textContent = LOADWORDS[lwIdx];
            lwEl.classList.remove("sj-swapw");
          }, 200);
        });
      }, 2600));
    }

    // ---- dashboard: week / month / year, switched by hand ----
    const DMODES: Record<string, { count: number; range: string; msg: string; recap: number[]; bars: number[][] }> = {
      week: { count: 189, range: "Aug 4th - Aug 10th", msg: "You met your goal 3 times!", recap: [3, 15, 15, 30],
        bars: [[60, 30, 80], [45, 90, 65], [70, 40, 55], [35, 75, 95]] },
      month: { count: 357, range: "August 2025", msg: "You're on a roll this month!", recap: [9, 45, 25, 40],
        bars: [[45, 70, 35], [80, 55, 95], [30, 60, 85], [65, 90, 50]] },
      year: { count: 1402, range: "2025", msg: "Slow and steady, all year long.", recap: [38, 190, 120, 160],
        bars: [[35, 60, 90], [75, 85, 60], [55, 30, 70], [45, 95, 70]] },
    };
    function countTo(el: HTMLElement | null, target: number, dur: number) {
      if (!el) return;
      const from = parseInt(String(el.textContent).replace(/\D/g, ""), 10) || 0;
      if (REDUCE || !dur) { el.textContent = String(target); return; }
      const t0 = performance.now();
      const step = (now: number) => {
        const p = Math.min(1, (now - t0) / dur);
        el.textContent = String(Math.round(from + (target - from) * (1 - Math.pow(1 - p, 3))));
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }
    function setDashMode(mode: string) {
      const M = DMODES[mode];
      document.querySelectorAll<HTMLElement>("[data-sj-seg] span").forEach((sp) =>
        sp.classList.toggle("on", sp.dataset.mode === mode));
      const range = document.querySelector<HTMLElement>("[data-sj-range]");
      if (range) range.textContent = M.range;
      const msg = document.querySelector<HTMLElement>("[data-sj-msg]");
      if (msg) msg.textContent = M.msg;
      countTo(document.querySelector("[data-sj-count]"), M.count, 900);
      document.querySelectorAll<HTMLElement>("[data-sj-recap]").forEach((el) =>
        countTo(el, M.recap[parseInt(el.dataset.sjRecap || "0", 10)], 550));
      document.querySelectorAll<HTMLElement>(".sj-rcard").forEach((card, ci) => {
        card.querySelectorAll<HTMLElement>(".sj-bars i").forEach((bar, bi) => {
          bar.style.height = (M.bars[ci]?.[bi] ?? 50) + "%";
        });
      });
      document.querySelectorAll<HTMLElement>("[data-sj-panel]").forEach((p) => {
        if (p.dataset.sjPanel === mode) p.removeAttribute("hidden");
        else p.setAttribute("hidden", "");
      });
    }
    document.querySelectorAll<HTMLElement>("[data-sj-seg] span").forEach((sp) =>
      sp.addEventListener("click", () => setDashMode(sp.dataset.mode || "week")));
  }

  document.addEventListener("astro:before-swap", sjTeardown);
  initSj();
  document.addEventListener("astro:page-load", initSj);
