  .case--fliz.fz-motion .prose :global(.fz-gallery) { overflow: visible; }
  .case--fliz.fz-motion .prose :global(.fz-gallery__hint) { display: none; }

  /* ---------- heading colour-wipe (motion only) ---------- */
  @media (prefers-reduced-motion: no-preference) {
