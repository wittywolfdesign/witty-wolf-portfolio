  }
  .prose :global(.fz-gallery__track) {
    display: flex;
    gap: clamp(1rem, 3vw, 2rem);
    width: max-content;
    align-items: start;
  }
  .prose :global(.fz-slide) {
    margin: 0;
    flex: 0 0 auto;
    width: clamp(200px, 40vw, 260px);
  }
  .prose :global(.fz-slide figcaption) {
    margin-top: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.02em;
    color: var(--text-muted);
    padding-left: 0.6rem;
    border-left: 2px solid var(--brand-accent);
