  :global(.lenis.lenis-smooth) { scroll-behavior: auto !important; }
  :global(.lenis.lenis-smooth [data-lenis-prevent]) { overscroll-behavior: contain; }
  :global(.lenis.lenis-stopped) { overflow: clip; }
  :global(.lenis.lenis-smooth iframe) { pointer-events: none; }
